---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import { profile } from '../profile';
interface Props { title: string; description?: string; }
const { title, description = `${profile.name}, software engineer. A personal portfolio of work and ideas.` } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#D9D9D8" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Navbar />
    <main id="main"><slot /></main>
    <slot name="overlay" />
    <footer class="site-footer frame">
      <a href="/" aria-label={`${profile.shortName}, home`}><img src="/logo.svg" width="32" height="32" alt="" /></a>
      <p>&copy; {new Date().getFullYear()} {profile.name}</p>
      <a href="#main">Back to top</a>
    </footer>
  </body>
</html>
