---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { profile } from '../profile';
const projects = (await getCollection('work', ({ data }) => !data.draft)).sort((a, b) => b.data.year - a.data.year);
const contacts = [
  ...(profile.email ? [{ label: 'Email me', url: `mailto:${profile.email}` }] : []),
  ...(profile.github ? [{ label: 'GitHub', url: profile.github }] : []),
  ...(profile.linkedin ? [{ label: 'LinkedIn', url: profile.linkedin }] : []),
];
---
<BaseLayout title={`${profile.name} | Software Engineer`}>
  <section class="hero frame" aria-labelledby="hero-title">
    <div class="hero-sheet" data-rebuild="box">
      <div class="hero-top" data-rebuild="text"><span>Portfolio</span><button type="button" class="intro-trigger" id="replay-intro" hidden><svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m7 4 9 6-9 6V4Z" /></svg>Play intro</button></div>
      <div class="name-stage">
        <div class="name-selection" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
        <h1 id="hero-title"><span data-rebuild="text">Felix</span><span data-rebuild="text">Erawan.</span></h1>
        <span class="author-tag" aria-hidden="true">Felix</span>
      </div>
      <div class="hero-bottom" data-rebuild="text">
        <p>Software engineer.</p>
        <a class="primary-button" href="#work">Open my portfolio <span aria-hidden="true">+</span></a>
      </div>
    </div>
    <div class="hero-caption"><a href="#work">Explore the folders</a><span id="intro-motion-note" hidden>Intro skipped: reduced motion is enabled.</span></div>
  </section>
  <div class="portfolio-folders frame">
    <section class="folder folder-work" id="work" aria-labelledby="work-title">
      <div class="folder-tab"><span>01</span><span>Selected work</span></div>
      <div class="folder-body">
        <div class="section-heading"><h2 id="work-title">The work folder.</h2></div>
        {projects.length ? <div class="project-grid">{projects.map(p => <ProjectCard slug={p.id} title={p.data.title} summary={p.data.summary} tools={p.data.tools} year={p.data.year} />)}</div> :
          <div class="empty-work"><svg viewBox="0 0 112 88" width="112" height="88" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M10 25V13h32l10 12h50v48H10V25Z"/><path d="M10 33h92M46 53h20M56 43v20"/></svg><div><h3>Projects are on the way.</h3><p>This folder will hold my selected projects and the stories behind them.</p></div><span class="file-label">Nothing filed yet</span></div>}
      </div>
    </section>
    <section class="folder folder-about" id="about" aria-labelledby="about-title">
      <div class="folder-tab"><span>02</span><span>About me</span></div>
      <div class="folder-body">
        <div class="section-heading"><h2 id="about-title">Hello, I’m Felix.</h2></div>
        <div class="about-layout"><p class="about-name">Gregorius Felix<br />Caton Erawan.</p><div class="about-copy"><p>I’m a software engineer. This is my personal space for the things I build.</p><a class="text-link" href="/about">A little more about me</a></div></div>
      </div>
    </section>
    <section class="folder folder-contact" id="contact" aria-labelledby="contact-title">
      <div class="folder-tab"><span>03</span><span>Résumé &amp; contact</span></div>
      <div class="folder-body">
        <div class="section-heading"><h2 id="contact-title">Keep in touch.</h2></div>
        <div class="contact-layout"><p class="contact-statement">{contacts.length ? 'Say hello.' : <>Contact details<br />coming soon.</>}</p><div class="contact-links">{contacts.map(link => <a href={link.url}>{link.label}<span aria-hidden="true">↗</span></a>)}{profile.resume && <a href={profile.resume} target="_blank" rel="noopener">Read my résumé<span aria-hidden="true">↗</span></a>}</div></div>
      </div>
    </section>
  </div>
  <div slot="overlay" id="swarm-intro" class="swarm-intro" hidden>
    <div id="swarm-scene" class="swarm-scene" aria-hidden="true" inert></div>
    <div class="intro-toolbar"><span id="intro-status" role="status">Assembling an introduction…</span><button type="button" id="skip-intro">Skip intro <span aria-hidden="true">Esc</span></button></div>
  </div>
  <script>
    import { initSwarmIntro } from '../scripts/swarm-intro';
    initSwarmIntro();
  </script>
</BaseLayout>
