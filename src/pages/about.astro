---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../profile';
---
<BaseLayout title={`About | ${profile.name}`}>
  <article class="frame about-page">
    <a class="text-link" href="/#about">Back to the portfolio</a>
    <h1>Gregorius Felix<br />Caton Erawan.</h1>
    <p class="about-page-role">Software Engineer</p>
    <p class="prose">I'm Felix, a software engineer. This portfolio is a place for my projects and the work behind them. More about my background will follow.</p>
    {profile.resume && <p><a class="text-link" href={profile.resume} target="_blank" rel="noopener">Read my résumé</a></p>}
    <a class="text-link" href="/#work">View the work folder</a>
  </article>
</BaseLayout>
