---
interface Props {
  slug: string;
  title: string;
  summary: string;
  tools: string[];
  year: number;
}
const { slug, title, summary, tools, year } = Astro.props;
---
<a class="project-card" href={`/work/${slug}`}>
  <h3>{title}</h3>
  <p>{summary}</p>
  <p class="project-meta">{year}, {tools.join(', ')}</p>
</a>
<style>
  .project-card { display: block; padding-block: var(--space-lg); border-top: 1px solid currentColor; text-decoration: none; }
  h3 { font-size: var(--text-xl); margin-bottom: var(--space-sm); }
  p { margin-bottom: var(--space-xs); }
  .project-meta { font-size: var(--text-sm); }
  @media (hover: hover) and (pointer: fine) { .project-card:hover h3 { text-decoration: underline; text-underline-offset: 4px; } }
</style>
