---
interface Props {
  slug: string;
  title: string;
  summary: string;
  tools: string[];
  year: number;
}
const { slug, title, summary, tools, year } = Astro.props;
---
<a class="card" href={`/work/${slug}`}>
  <div class="thumb" aria-hidden="true"></div>
  <h3>{title}</h3>
  <p class="muted">{summary}</p>
  <p class="meta muted">{year}, {tools.join(', ')}</p>
</a>

<style>
  .card { display: block; text-decoration: none; }
  .thumb {
    aspect-ratio: 4 / 3;
    background: var(--line);
    border-radius: 0.5rem;
    margin-bottom: 1rem;
    transition: background 0.2s;
  }
  .card:hover .thumb { background: var(--accent); }
  h3 { font-size: 1.25rem; margin-bottom: 0.25rem; }
  p { margin: 0 0 0.5rem; }
  .meta { font-size: 0.9rem; }
</style>
