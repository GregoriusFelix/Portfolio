---
const links = [
  { href: '/', label: 'Home' },
  { href: '/#work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/#contact', label: 'Contact' },
];
---
<header class="wrap bar">
  <a href="/" class="logo">Your Name</a>
  <nav aria-label="Main">
    <ul>
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>
</header>

<style>
  .bar { display: flex; justify-content: space-between; align-items: center; padding-block: 1.25rem; }
  .logo { font-weight: 800; text-decoration: none; }
  ul { display: flex; gap: 1.5rem; list-style: none; margin: 0; padding: 0; }
  nav a { text-decoration: none; color: var(--muted); }
  nav a:hover { color: var(--ink); }
</style>
